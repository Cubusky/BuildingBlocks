<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyAllFiles>true</CopyAllFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>./nupkg</OutputPath>
    <DebugType>portable</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>

    <Title>BuildingBlocks</Title>
    <Version>0.0.0-devbuild</Version>
    <Description>Cubusky.BuildingBlocks description.</Description>
    <Copyright>© 2026 Cubusky</Copyright>
    <Authors>Cubusky</Authors>
    <Company>Cubusky</Company>

    <PackageId>Cubusky.BuildingBlocks</PackageId>
    <PackageReleaseNotes>BuildingBlocks release.</PackageReleaseNotes>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags />
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://www.nuget.org/packages/Cubusky.BuildingBlocks</PackageProjectUrl>

    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Cubusky/BuildingBlocks</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="./icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dependencies go here. -->
    <PackageReference Include="IsExternalInit" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Analyzers" Version="1.11.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="SpellCheck" BeforeTargets="CoreCompile" Condition="'$(BuildingInsideVisualStudio)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(SkipSpellCheck)' != 'true'">
    <Exec Command="npx --yes --prefer-offline --fetch-retries=0 --fetch-timeout=5000 cspell@10.4.0 --no-progress --no-color --no-summary --config ./cspell.json --gitignore --cache &quot;**&quot;" WorkingDirectory="$(MSBuildThisFileDirectory).." ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="SpellCheckLine" />
    </Exec>
    <ItemGroup>
      <SpellCheckIssue Include="@(SpellCheckLine)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^.+?:\d+:\d+ - '))" />
    </ItemGroup>
    <Warning Condition="'@(SpellCheckIssue)' != ''" Code="SPELL" File="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..', $([System.Text.RegularExpressions.Regex]::Replace('%(SpellCheckIssue.Identity)', '^(.+?):\d+:\d+ - .*$', '$1'))))" Text="$([System.Text.RegularExpressions.Regex]::Replace('%(SpellCheckIssue.Identity)', '^.+?:(\d+:\d+ - .*)$', '$1'))" />
  </Target>
</Project>
